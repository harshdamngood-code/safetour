# ============================================================
# BillFlow SaaS Environment Configuration (All Optional)
# ============================================================
# Note: The application runs out-of-the-box with embedded SQLite
# and auto-derived JWT secrets if these variables are left blank.

# Optional: External PostgreSQL Database URI (postgres://user:pass@host:5432/dbname)
DATABASE_URL=""

# Optional: Custom JWT Secrets (auto-generated if left empty)
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# Optional: Razorpay Payment Gateway (for live subscription checkout)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""


